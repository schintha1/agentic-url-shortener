DATABASE_URL=sqlite:///data/shortener.db
RUNS_DIR=runs
BASE_URL=http://localhost:8000
RATE_LIMIT_PER_MINUTE=30
ALLOW_PRIVATE_TARGETS=true

# Set this in any deployment: when present, every /sdlc route requires X-API-Key.
# Left empty the control plane is open, which is acceptable only for a local demo.
SDLC_API_KEY=

# Retention window for click records, used by the purge helper.
CLICK_RETENTION_DAYS=30

# Suite the orchestrator's test stage executes. Must be a path under tests/.
DOMAIN_TEST_TARGET=tests/test_shortener.py

# Test-only: allow inject_failure_node on create-run. Leave false outside pytest.
ALLOW_FAILURE_INJECTION=false

LOG_LEVEL=INFO
